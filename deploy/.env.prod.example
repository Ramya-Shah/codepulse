# Server .env for docker-compose.prod.yml. Copy to .env on the VM and fill in.
# Never commit the filled-in file.

# Public hostname Caddy gets an HTTPS certificate for (e.g. codepulse-demo.duckdns.org)
DOMAIN=
# Dashboard origin allowed to call the API (comma-separated)
CORS_ORIGIN=https://codepulse-live.vercel.app,https://codepulse-codepulse-dashboard.vercel.app

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
INGEST_API_KEY=

# AI root-cause analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Simulated demo traffic; kept low for a shared-core VM
DEMO_REQUESTS_PER_SECOND=10
