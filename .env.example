# Copy to .env (never commit .env). Every value here is optional for local use.
POSTGRES_PASSWORD=codepulse
# Key SDKs send in x-api-key. Use a long random value anywhere public.
INGEST_API_KEY=local-dev-key
# Optional: raises the GitHub API rate limit for the server-side /tree fetch.
GITHUB_TOKEN=
DEMO_REQUESTS_PER_SECOND=40
